# Phone Provider (twilio or telnyx)
GEMINICALL_PROVIDER=twilio

# Phone Numbers (E.164 format)
GEMINICALL_USER_PHONE=+15551234567
GEMINICALL_FROM_PHONE=+15559876543

# Twilio Credentials
GEMINICALL_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINICALL_TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telnyx Credentials
GEMINICALL_TELNYX_API_KEY=KEY_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINICALL_TELNYX_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI API Key (for TTS and STT)
GEMINICALL_OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ngrok Auth Token
GEMINICALL_NGROK_AUTHTOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional Settings
GEMINICALL_PORT=3333
GEMINICALL_VOICE=onyx
GEMINICALL_TIMEOUT=180000
